---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold m-0">404</h1>
    <p class="text-gray-600 mt-3">你要找的页面不存在，或已被移动。</p>
    <p class="mt-4">
      <a href="/" class="no-underline text-brand">← 返回首页</a>
    </p>
  </div>
</BaseLayout>
