---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { COLUMNS } from '../../consts';

export async function getStaticPaths() {
  const columns = ['ai', 'tools', 'resources', 'humanities'] as const;
  return columns.map((col) => ({ params: { column: col } }));
}

const column = Astro.params.column as keyof typeof COLUMNS;
const colInfo = COLUMNS[column];
const entries = (await getCollection(column))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={colInfo.name} description={colInfo.desc}>
  <h1 class="text-2xl font-bold mb-1">{colInfo.name}</h1>
  <p class="text-gray-600 mb-6">{colInfo.desc}</p>
  <div class="grid gap-4">
    {entries.map((e) => <PostCard entry={e} />)}
    {entries.length === 0 && <p class="text-gray-500">暂无内容，敬请期待。</p>}
  </div>
</BaseLayout>
