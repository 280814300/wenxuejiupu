---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { COLUMNS, SITE } from '../../consts';

export async function getStaticPaths() {
  const columns = ['ai', 'tools', 'resources', 'humanities'] as const;
  const paths = [];
  for (const col of columns) {
    const entries = await getCollection(col);
    for (const entry of entries) {
      if (entry.data.draft && !import.meta.env.DEV) continue;
      paths.push({
        params: {
          column: col,
          slug: entry.data.slug,
        },
        props: { entry },
      });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const d = entry.data;
const colKey = entry.collection as keyof typeof COLUMNS;
const colName = COLUMNS[colKey].name;

// 同栏目内排序：开卷八分钟系列按节目播出日期（从 slug 解析 YYYYMMDD），其余按发布时间；
// 升序后 上一篇=较早一篇、下一篇=较晚一篇，保证系列按集顺序前后跳转。
function orderTs(e: any): number {
  const m = e.data.slug.match(/kaijuan-youyi-(\d{2})(\d{2})(\d{2})/);
  if (m) return new Date(2000 + +m[1], +m[2] - 1, +m[3]).getTime();
  return e.data.pubDate.getTime();
}
const siblings = (await getCollection(entry.collection))
  .filter((e) => !e.data.draft)
  .sort((a, b) => orderTs(a) - orderTs(b));
const idx = siblings.findIndex((e) => e.data.slug === d.slug);
const prevPost = idx > 0 ? siblings[idx - 1] : null;
const nextPost = idx < siblings.length - 1 ? siblings[idx + 1] : null;

const articleUrl = new URL(
  `/${entry.collection}/${d.slug}/`,
  Astro.site
).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: SITE.title },
  mainEntityOfPage: articleUrl,
  keywords: d.tags.join(', '),
};

// GEO / 富结果增强：从标题/摘要派生书籍实体，补 Book + Review 结构化数据
const bookMatch = d.title.match(/《(.+?)》/);
const bookName = bookMatch ? bookMatch[1] : '';
const bookAuthor = (d.description.split('《')[0] || '')
  .replace(/的$/, '')
  .trim();
const genreTags = d.tags.filter((t: string) => !['开卷八分钟', '读书'].includes(t));
const bookLd = bookName
  ? {
      '@context': 'https://schema.org',
      '@type': 'Book',
      name: bookName,
      inLanguage: 'zh-CN',
      author: bookAuthor ? { '@type': 'Person', name: bookAuthor } : undefined,
      about: genreTags,
      publisher: { '@type': 'Organization', name: SITE.title },
    }
  : null;
const reviewLd = bookName
  ? {
      '@context': 'https://schema.org',
      '@type': 'Review',
      name: d.title,
      reviewBody: d.description,
      datePublished: d.pubDate.toISOString(),
      author: { '@type': 'Organization', name: d.author },
      publisher: { '@type': 'Organization', name: SITE.title },
      itemReviewed: {
        '@type': 'Book',
        name: bookName,
        author: bookAuthor ? { '@type': 'Person', name: bookAuthor } : undefined,
      },
    }
  : null;
const jsonLdAll = [jsonLd, bookLd, reviewLd].filter(Boolean) as Record<
  string,
  unknown
>[];
---

<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  pubDate={d.pubDate}
  ogImage={d.cover}
  jsonLd={jsonLdAll}
>
  <div
    class="lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-8 lg:items-start"
  >
    <article class="prose min-w-0">
      <div class="meta-mono text-gray-500 mb-2">
        <a
          href={`/${entry.collection}/`}
          class="no-underline text-inherit hover:text-brand">{colName}</a
        >
        · {d.pubDate.toISOString().slice(0, 10)}
        {
          d.updatedDate && (
            <span> · 更新 {d.updatedDate.toISOString().slice(0, 10)}</span>
          )
        }
      </div>
      <h1 class="text-3xl font-bold mt-0 mb-2">{d.title}</h1>
      <p class="text-gray-600 mb-3">{d.description}</p>
      {
        d.tags.length > 0 && (
          <div class="flex flex-wrap gap-1 mb-4 meta-mono">
            {d.tags.map((t: string) => (
              <a href={`/tags/${encodeURIComponent(t)}/`} class="tag-pill no-underline">#{t}</a>
            ))}
          </div>
        )
      }
      {
        d.cover && (
          <img src={d.cover} alt={d.title} class="cover-img" />
        )
      }
      <hr class="border-gray-200 my-4" />
      <div class="prose-body">
        <Content />
      </div>

      <hr class="border-gray-200 my-6" />

      <!-- 本文信息 -->
      <div class="card p-4 text-sm space-y-2">
        <div>
          <span class="text-gray-500">本文标题：</span>
          <span class="font-medium">{d.title}</span>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-1">
          <span class="text-gray-500 shrink-0">本文链接：</span>
          <a href={articleUrl} class="break-all text-inherit hover:text-brand"
            >{articleUrl}</a
          >
        </div>
        {
          d.tags.length > 0 && (
            <div class="flex flex-wrap items-start gap-2">
              <span class="text-gray-500 shrink-0">标签：</span>
              <div class="flex flex-wrap gap-1">
                {d.tags.map((t: string) => (
                  <a href={`/tags/${encodeURIComponent(t)}/`} class="tag-pill no-underline">#{t}</a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- 上一篇 / 下一篇 -->
      {
        (prevPost || nextPost) && (
          <nav
            class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4"
            aria-label="上一篇与下一篇"
          >
            <div>
              {prevPost ? (
                <a
                  href={`/${prevPost.collection}/${prevPost.data.slug}/`}
                  class="card block p-3 no-underline text-inherit h-full"
                >
                  <div class="text-xs text-gray-500 mb-1">← 上一篇</div>
                  <div class="font-medium leading-snug">
                    {prevPost.data.title}
                  </div>
                </a>
              ) : (
                <span class="text-sm text-gray-500">已经是第一篇</span>
              )}
            </div>
            <div>
              {nextPost ? (
                <a
                  href={`/${nextPost.collection}/${nextPost.data.slug}/`}
                  class="card block p-3 no-underline text-inherit h-full text-right"
                >
                  <div class="text-xs text-gray-500 mb-1">下一篇 →</div>
                  <div class="font-medium leading-snug">
                    {nextPost.data.title}
                  </div>
                </a>
              ) : (
                <span class="text-sm text-gray-500">已经是最新一篇</span>
              )}
            </div>
          </nav>
        )
      }

      <RelatedPosts
        slug={d.slug}
        collection={entry.collection}
        tags={d.tags}
      />

      <p class="text-sm text-gray-500 mt-6">
        <a
          href={`/${entry.collection}/`}
          class="no-underline text-inherit hover:text-brand">← 返回 {colName}</a
        >
      </p>
    </article>

    <Sidebar toc={toc} />
  </div>
</BaseLayout>
