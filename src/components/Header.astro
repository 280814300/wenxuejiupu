---
import { SITE, NAV } from '../consts';
---

<header class="site-header">
  <div
    class="w-full max-w-5xl mx-auto px-4 py-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-bold no-underline text-inherit"
    >
      <img src="/favicon.svg" alt="" width="28" height="28" class="rounded" />
      <span>{SITE.title}</span>
      <span class="text-sm font-normal text-gray-500 hidden sm:inline"
        >· {SITE.slogan}</span
      >
    </a>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="主导航">
        {
          NAV.map((item) => (
            <a
              href={`/${item.slug}/`}
              class="no-underline text-inherit hover:text-brand"
            >
              {item.name}
            </a>
          ))
        }
        <a href="/about/" class="no-underline text-inherit hover:text-brand">关于</a>
      </nav>
      <form class="flex items-center" action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="搜索文章…"
          aria-label="搜索"
          class="w-32 sm:w-40 px-3 py-1.5 rounded-lg border border-[var(--card-border)] bg-[var(--card-bg)] text-sm text-[var(--text)] outline-none focus:border-[var(--brand)]"
        />
      </form>
    </div>
  </div>
</header>
