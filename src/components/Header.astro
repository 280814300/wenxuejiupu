---
import { SITE, NAV } from '../consts';
---

<header class="site-header">
  <div
    class="w-full max-w-5xl mx-auto px-4 py-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-bold no-underline text-inherit"
    >
      <img src="/favicon.svg" alt="" width="28" height="28" class="rounded" />
      <span>{SITE.title}</span>
    </a>
    <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={`/${item.slug}/`}
            class="no-underline text-inherit hover:text-brand"
          >
            {item.name}
          </a>
        ))
      }
      <a href="/guestbook/" class="no-underline text-inherit hover:text-brand">留言</a>
      <a href="/about/" class="no-underline text-inherit hover:text-brand">关于</a>
      <a href="/rss.xml" class="no-underline text-inherit hover:text-brand">RSS</a>
    </nav>
  </div>
</header>
